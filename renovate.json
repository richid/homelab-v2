{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "major": {
    "dependencyDashboardApproval": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^nix/variables\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"]+)\";\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "b4bz/homer",
        "eclipse-mosquitto",
        "fallenbagel/jellyseerr",
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/analogj/scrutiny",
        "ghcr.io/chrisbenincasa/tunarr",
        "ghcr.io/gotify/server",
        "ghcr.io/richid/caddy-docker-proxy-r53-dns",
        "ghcr.io/richid/trackage",
        "grafana/grafana",
        "itzg/minecraft-server",
        "louislam/uptime-kuma",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/smokeping",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/syncthing",
        "lscr.io/linuxserver/transmission",
        "lscr.io/linuxserver/unifi-network-application",
        "sjmayotte/route53-dynamic-dns",
        "vabene1111/recipes",
        "vikunja/vikunja"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<17"
    },
    {
      "matchPackageNames": ["mongo"],
      "allowedVersions": "<5"
    },
    {
      "matchPackageNames": ["influxdb"],
      "allowedVersions": "<3"
    },
    {
      "matchPackageNames": ["b4bz/homer"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": [
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/richid/trackage",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/syncthing"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["ghcr.io/analogj/scrutiny"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+-omnibus$/"
    },
    {
      "matchPackageNames": ["itzg/minecraft-server"],
      "allowedVersions": "/^\\d{4}\\.\\d+\\.\\d+-java21$/"
    }
  ]
}
