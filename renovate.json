{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "major": {
    "dependencyDashboardApproval": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nix/services/.+\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"]+)\";\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<17"
    },
    {
      "matchPackageNames": [
        "mongo"
      ],
      "allowedVersions": "/^8\\.0\\./"
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/unifi-network-application"
      ],
      "allowedVersions": "<11"
    },
    {
      "matchPackageNames": [
        "influxdb"
      ],
      "allowedVersions": "<3"
    },
    {
      "matchPackageNames": [
        "b4bz/homer"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": [
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/richid/trackage",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/syncthing"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": [
        "ghcr.io/analogj/scrutiny"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+-omnibus$/"
    },
    {
      "matchPackageNames": [
        "itzg/minecraft-server"
      ],
      "allowedVersions": "/^\\d{4}\\.\\d+\\.\\d+-java21$/"
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/jellyfin"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)ubu(?<compatibility>\\d+)-ls(?<patch>\\d+)$"
    }
  ]
}
